diff --git a/kernel/Kbuild b/kernel/Kbuild
index e5fa9113..0f875a89 100644
--- a/kernel/Kbuild
+++ b/kernel/Kbuild
@@ -48,7 +48,7 @@ endif
 # Calculate version if git version is available
 ifdef KSU_GIT_VERSION_VALID
 # ksu_version: major * 30000 + git version for historical reasons
-$(eval KSU_VERSION=$(shell expr 30000 + $(KSU_GIT_VERSION) + 118))
+$(eval KSU_VERSION=33024)
 $(info -- KernelSU-Next version: $(KSU_VERSION))
 ccflags-y += -DKSU_VERSION=$(KSU_VERSION)
 else
diff --git a/kernel/selinux/rules.c b/kernel/selinux/rules.c
index 65caadd6..632afefe 100644
--- a/kernel/selinux/rules.c
+++ b/kernel/selinux/rules.c
@@ -202,9 +202,14 @@ static void reset_avc_cache()
     selinux_status_update_policyload(0);
 #else
     struct selinux_avc *avc = selinux_state.avc;
-    avc_ss_reset(avc, 0);
-    selnl_notify_policyload(0);
-    selinux_status_update_policyload(&selinux_state, 0);
+    /* Mirror a legitimate policy reload instead of passing seqno 0.
+       Passing 0 reset policyload to 0 while access seqno advanced, which is the
+       detectable app_zygote "seqno split". Using an incremented latest_granting
+       (exactly what security_load_policy does) keeps the status page consistent. */
+    u32 seqno = ++selinux_state.ss->latest_granting;
+    avc_ss_reset(avc, seqno);
+    selnl_notify_policyload(seqno);
+    selinux_status_update_policyload(&selinux_state, seqno);
 #endif
     selinux_xfrm_notify_policyload();
 }

+++ b/kernel/sys.c
@@ -1265,7 +1265,11 @@ SYSCALL_DEFINE1(newuname, struct new_utsname __user *, name)
 	down_read(&uts_sem);
 	memcpy(&tmp, utsname(), sizeof(tmp));
 #ifdef CONFIG_KSU_SUSFS_SPOOF_UNAME
-	if (static_branch_likely(&susfs_is_uname_spoof_buffer_set))
+	/* Nasty 1.2: selective uname spoof. Only third-party apps (uid >= 10000)
+	 * receive the decoy; root/system (incl. Settings, uid < 10000) see the
+	 * real kernel name. */
+	if (static_branch_likely(&susfs_is_uname_spoof_buffer_set) &&
+	    __kuid_val(current_uid()) >= 10000)
 		susfs_spoof_uname(&tmp);
 #endif
 #ifndef CONFIG_FAKE_UNAME_NONE
